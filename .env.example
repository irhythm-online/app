# Copy this file to .env and fill in real values.
# All of these are read in app.config.ts and exposed to the app via
# `Constants.expoConfig.extra` — see src/api/client.ts and src/auth/cognito.ts.

# Base URL of the IRhythm REST API (see API_CONTRACT.md), e.g. https://api.irhythm.example.com/v1
API_BASE_URL=https://api.irhythm.example.com/v1

# Cognito User Pool used for email+password sign in / sign up (SRP auth).
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS region the Cognito User Pool lives in.
AWS_REGION=ap-south-1
